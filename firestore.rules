rules_version = '2';

// Behörigheter lagras i users/{uid}.permissions (beslut 0005, docs/roller-och-behorigheter.md).
// UI:t döljer funktioner men det är dessa regler som skyddar. Ändringar kräver regeltester (tests/rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function has(permission) {
      return signedIn() && exists(userDoc()) && permission in get(userDoc()).data.permissions;
    }

    function allPermissions() {
      return ['member', 'course_setter', 'publisher', 'board', 'superadmin'];
    }

    // Det styrelsen får tilldela och ta bort
    function boardAssignable() {
      return ['member', 'course_setter', 'publisher'];
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validPermissions(list) {
      return list is list
        && list.size() <= allPermissions().size()
        && list.toSet().size() == list.size()
        && list.toSet().hasOnly(allPermissions());
    }

    // Behörigheter som lagts till eller tagits bort i denna skrivning
    function changedPermissions() {
      let before = resource.data.permissions.toSet();
      let after = request.resource.data.permissions.toSet();
      return after.difference(before).union(before.difference(after));
    }

    // Ingen får ta bort sin egen superadmin (skydd mot att låsa ute sig)
    function keepsOwnSuperadmin(uid) {
      return !(uid == request.auth.uid
        && 'superadmin' in resource.data.permissions
        && !('superadmin' in request.resource.data.permissions));
    }

    // ---- Events ----------------------------------------------------------------
    // Utkastet är fälten på dokumentet; `published` är ögonblicksbilden som är live.
    // Bygget läser bara `published` för events med status 'published' (via Admin SDK).

    function canPublish() {
      return signedIn() && exists(userDoc())
        && get(userDoc()).data.permissions.hasAny(['publisher', 'board', 'superadmin']);
    }

    // courseFiles är valfri på dokumentet (events skapade före PDF-banor saknar den) men får finnas.
    function requiredEventKeys() {
      return ['type', 'title', 'startsAt', 'endsAt', 'location', 'body', 'courseSetter', 'livelox',
        'status', 'slug', 'published', 'publishedAt', 'source',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'];
    }

    function eventKeys() {
      return requiredEventKeys().concat(['courseFiles']);
    }

    // Storage-sökvägen ska ligga under courses/<eventId>/ och sluta på .pdf (filen laddas upp via storage.rules).
    // Skrivet med få uttryck (taket på 1000 per anrop, se validCourseFiles): keys() ger fel om f inte är en map
    // och matches() ger fel om värdet inte är en sträng, vilket nekar skrivningen. Längdgränserna ligger i
    // regexen: name 1–200 tecken, label 0–200, filnamnsdelen av storagePath högst 200 tecken.
    function validCourseFile(f, prefix) {
      return f.keys().hasOnly(['name', 'storagePath', 'label'])
        && f.name.matches('(?s).{1,200}')
        && f.label.matches('(?s).{0,200}')
        && f.storagePath.matches(prefix + '[A-Za-z0-9][A-Za-z0-9._-]{0,195}[.]pdf$');
    }

    // Saknad nyckel i f ger utvärderingsfel och därmed nekad skrivning (täcks av test). hasAll utelämnad: rules har ett
    // tak på antal uttryck per anrop och 8 filer ryms inte med den.
    // Rules saknar loopar: kontrollera varje plats för sig. Gränsen är 8 (MAX_COURSE_FILES).
    function validCourseFiles(l, eventId) {
      let prefix = '^courses/' + eventId + '/';
      return validCourseFilesIn(l, prefix);
    }

    function validCourseFilesIn(l, prefix) {
      return l is list && l.size() <= 8
        && (l.size() < 1 || validCourseFile(l[0], prefix))
        && (l.size() < 2 || validCourseFile(l[1], prefix))
        && (l.size() < 3 || validCourseFile(l[2], prefix))
        && (l.size() < 4 || validCourseFile(l[3], prefix))
        && (l.size() < 5 || validCourseFile(l[4], prefix))
        && (l.size() < 6 || validCourseFile(l[5], prefix))
        && (l.size() < 7 || validCourseFile(l[6], prefix))
        && (l.size() < 8 || validCourseFile(l[7], prefix));
    }

    function courseFilesOf(d) {
      return d.get('courseFiles', []);
    }

    function validEventContent(d, eventId) {
      return d.type in ['training', 'competition', 'meeting', 'info', 'happening']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.startsAt is timestamp && d.endsAt is timestamp && d.endsAt >= d.startsAt
        && d.location is map && d.location.keys().hasOnly(['name', 'mapUrl'])
        && d.location.name is string && d.location.name.size() <= 200
        && d.location.mapUrl is string && d.location.mapUrl.size() <= 500
        && d.body is string && d.body.size() <= 20000
        && d.courseSetter is string && d.courseSetter.size() <= 200
        && d.livelox is string && d.livelox.size() <= 500
        && validCourseFiles(courseFilesOf(d), eventId);
    }

    function eventSnapshot(d) {
      return {
        'type': d.type, 'title': d.title, 'startsAt': d.startsAt, 'endsAt': d.endsAt,
        'location': d.location, 'body': d.body, 'courseSetter': d.courseSetter, 'livelox': d.livelox,
        'courseFiles': courseFilesOf(d)
      };
    }

    function validSlug(slug) {
      return slug is string && slug.size() <= 120 && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    // Banläggare (beslut 0006): får läsa events och ändra courseFiles, inget annat.
    function isCourseSetter() {
      return signedIn() && exists(userDoc())
        && 'course_setter' in get(userDoc()).data.permissions;
    }

    // Banläggarens skrivning: bara courseFiles (+ updatedBy/updatedAt). Är eventet publicerat får samma
    // skrivning lägga exakt utkastets courseFiles i `published` (resten av snapshoten och publishedAt orörda),
    // så att banorna går live vid nästa bygge utan att övriga utkastsändringar publiceras.
    // status/slug/publishedAt finns inte bland tillåtna nycklar, så de kan inte ändras här.
    function courseSetterUpdate(eventId) {
      let after = request.resource.data;
      let changed = after.diff(resource.data).affectedKeys();
      return changed.hasOnly(['courseFiles', 'updatedBy', 'updatedAt', 'published'])
        && after.updatedBy == request.auth.uid
        && after.updatedAt == request.time
        // Nyckeln måste finnas efter skrivningen (validCourseFiles ger fel på saknat fält)
        && validCourseFiles(after.courseFiles, eventId)
        && (!changed.hasAny(['published'])
          || (resource.data.status == 'published'
            && after.published is map
            && after.published.diff(resource.data.published).affectedKeys().hasOnly(['courseFiles'])
            && after.published.courseFiles == after.courseFiles));
    }

    match /events/{eventId} {
      allow read: if canPublish() || isCourseSetter();


      allow create: if canPublish()
        && request.resource.data.keys().hasOnly(eventKeys())
        && request.resource.data.keys().hasAll(requiredEventKeys())
        && validEventContent(request.resource.data, eventId)
        && request.resource.data.status == 'draft'
        && request.resource.data.slug == null
        && request.resource.data.published == null
        && request.resource.data.publishedAt == null
        && request.resource.data.source == 'manual'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canPublish()
        && request.resource.data.keys().hasOnly(eventKeys())
        && request.resource.data.keys().hasAll(requiredEventKeys())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt', 'source'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        // Publicering: ögonblicksbilden ska vara exakt utkastet i samma skrivning
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['published', 'publishedAt'])
          || (request.resource.data.published == eventSnapshot(request.resource.data)
            && request.resource.data.publishedAt == request.time))
        // 'draft' bara för aldrig publicerade; publicerade/avpublicerade har ögonblicksbild och adress
        && (request.resource.data.status == 'draft'
          ? request.resource.data.published == null && request.resource.data.slug == null
          : request.resource.data.status in ['published', 'unpublished']
            && request.resource.data.published is map
            && validSlug(request.resource.data.slug))
        // Adressen låses vid första publiceringen (delade länkar ska fortsätta fungera)
        && (resource.data.publishedAt == null || request.resource.data.slug == resource.data.slug)
        // Innehållet (med upp till 8 banor) är dyrast och kontrolleras sist, så att en skrivning som ändå nekas
        // här inte förbrukar uttryckstaket innan banläggarregeln nedan prövas
        && validEventContent(request.resource.data, eventId);

      // Banläggare: bara banfiler (se courseSetterUpdate). Står efter publicerarregeln: taket på 1000 uttryck
      // gäller hela anropet, och publicerarregeln med 8 filer ligger nära taket.
      allow update: if isCourseSetter() && courseSetterUpdate(eventId);

      // Bara aldrig publicerade utkast får raderas; publicerade avpubliceras i stället
      allow delete: if canPublish() && resource.data.publishedAt == null;
    }

    // ---- Infosidor -------------------------------------------------------------------
    // Samma publiceringsmönster som events: utkastet är fälten på dokumentet, `published` är det som är live.
    // Bara publicerare, styrelse och superadmin har åtkomst (inte banläggare).

    function pageKeys() {
      return ['title', 'body', 'inMenu', 'menuOrder', 'menuLabel',
        'status', 'slug', 'published', 'publishedAt',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'];
    }

    function validPageContent(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.body is string && d.body.size() <= 50000
        && d.inMenu is bool
        && d.menuOrder is int && d.menuOrder >= 0 && d.menuOrder <= 999
        && d.menuLabel is string && d.menuLabel.size() <= 40;
    }

    function pageSnapshot(d) {
      return {
        'title': d.title, 'body': d.body, 'inMenu': d.inMenu, 'menuOrder': d.menuOrder, 'menuLabel': d.menuLabel
      };
    }

    // Sidor serveras på /<slug> och får inte krocka med sajtens egna adresser.
    // Håll listan synkad med RESERVED_PAGE_SLUGS i src/lib/slug.ts.
    function reservedPageSlugs() {
      return ['event', 'admin', 'sok', 'logga-in', 'pagefind', 'api', 'assets', '404', 'index', 'kalender',
        'traningskalender'];
    }

    match /pages/{pageId} {
      allow read: if canPublish();

      allow create: if canPublish()
        && request.resource.data.keys().hasOnly(pageKeys())
        && request.resource.data.keys().hasAll(pageKeys())
        && validPageContent(request.resource.data)
        && request.resource.data.status == 'draft'
        && request.resource.data.slug == null
        && request.resource.data.published == null
        && request.resource.data.publishedAt == null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canPublish()
        && request.resource.data.keys().hasOnly(pageKeys())
        && request.resource.data.keys().hasAll(pageKeys())
        && validPageContent(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        // Publicering: ögonblicksbilden ska vara exakt utkastet i samma skrivning
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['published', 'publishedAt'])
          || (request.resource.data.published == pageSnapshot(request.resource.data)
            && request.resource.data.publishedAt == request.time))
        // 'draft' bara för aldrig publicerade; publicerade/avpublicerade har ögonblicksbild och adress
        && (request.resource.data.status == 'draft'
          ? request.resource.data.published == null && request.resource.data.slug == null
          : request.resource.data.status in ['published', 'unpublished']
            && request.resource.data.published is map
            && validSlug(request.resource.data.slug)
            // Reserverade adresser kontrolleras när slug sätts (en senare reserverad adress låser inte en befintlig sida)
            && (request.resource.data.slug == resource.data.slug
              || !(request.resource.data.slug in reservedPageSlugs())))
        // Adressen låses vid första publiceringen (menyn och andra sidor länkar till den)
        && (resource.data.publishedAt == null || request.resource.data.slug == resource.data.slug);

      // Bara aldrig publicerade utkast får raderas; publicerade avpubliceras i stället
      allow delete: if canPublish() && resource.data.publishedAt == null;
    }

    // ---- Bygge ---------------------------------------------------------------------
    // meta/build.lastBuildAt skrivs bara av Actions (Admin SDK). Editorn läser den för delningsknappen.
    match /meta/build {
      allow read: if canPublish();
      allow write: if false;
    }

    // ---- Användare ---------------------------------------------------------------

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || has('board') || has('superadmin'));

      // Första inloggningen: eget dokument utan behörigheter. Kräver bekräftad e-post
      // (Google och e-postlänk är det direkt; lösenordskonton efter bekräftelsemejlet),
      // så att ingen kan registrera sig med någon annans adress och få dennes roller.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'permissions', 'createdAt'])
        && request.resource.data.permissions == []
        && request.resource.data.email == request.auth.token.email
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && (
        // Användaren själv: bara visningsnamn
        (request.auth.uid == uid
          && onlyChanges(['displayName'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100)
        // Superadmin: alla behörigheter
        || (has('superadmin')
          && onlyChanges(['permissions'])
          && validPermissions(request.resource.data.permissions)
          && keepsOwnSuperadmin(uid))
        // Styrelse: bara member, course_setter, publisher
        || (has('board')
          && onlyChanges(['permissions'])
          && validPermissions(request.resource.data.permissions)
          && changedPermissions().hasOnly(boardAssignable()))
      );

      allow delete: if false;
    }
  }
}
