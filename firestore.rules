rules_version = '2';

// Behörigheter lagras i users/{uid}.permissions (beslut 0005, docs/roller-och-behorigheter.md).
// UI:t döljer funktioner men det är dessa regler som skyddar. Ändringar kräver regeltester (tests/rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function has(permission) {
      return signedIn() && exists(userDoc()) && permission in get(userDoc()).data.permissions;
    }

    function allPermissions() {
      return ['member', 'course_setter', 'publisher', 'board', 'superadmin'];
    }

    // Det styrelsen får tilldela och ta bort
    function boardAssignable() {
      return ['member', 'course_setter', 'publisher', 'board'];
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validPermissions(list) {
      return list is list
        && list.size() <= allPermissions().size()
        && list.toSet().size() == list.size()
        && list.toSet().hasOnly(allPermissions());
    }

    // Behörigheter som lagts till eller tagits bort i denna skrivning
    function changedPermissions() {
      let before = resource.data.permissions.toSet();
      let after = request.resource.data.permissions.toSet();
      return after.difference(before).union(before.difference(after));
    }

    // Ingen får ta bort sin egen superadmin (skydd mot att låsa ute sig)
    function keepsOwnSuperadmin(uid) {
      return !(uid == request.auth.uid
        && 'superadmin' in resource.data.permissions
        && !('superadmin' in request.resource.data.permissions));
    }

    // ---- Events ----------------------------------------------------------------
    // Utkastet är fälten på dokumentet; `published` är ögonblicksbilden som är live.
    // Bygget läser bara `published` för events med status 'published' (via Admin SDK).

    function canPublish() {
      return signedIn() && exists(userDoc())
        && get(userDoc()).data.permissions.hasAny(['publisher', 'board', 'superadmin']);
    }

    // courseFiles är valfri på dokumentet (events skapade före PDF-banor saknar den) men får finnas.
    function requiredEventKeys() {
      return ['type', 'title', 'startsAt', 'endsAt', 'location', 'body', 'courseSetter', 'livelox',
        'status', 'slug', 'published', 'publishedAt', 'source',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'];
    }

    function eventKeys() {
      return requiredEventKeys().concat(['courseFiles', 'image', 'publisher', 'publishAt', 'resultsEnabled']);
    }

    // Storage-sökvägen ska ligga under courses/<eventId>/ och sluta på .pdf (filen laddas upp via storage.rules).
    // Skrivet med få uttryck (taket på 1000 per anrop, se validCourseFiles): keys() ger fel om f inte är en map
    // och matches() ger fel om värdet inte är en sträng, vilket nekar skrivningen. Längdgränserna ligger i
    // regexen: name 1–200 tecken, label 0–200, filnamnsdelen av storagePath högst 200 tecken.
    function validCourseFile(f, prefix) {
      return f.keys().hasOnly(['name', 'storagePath', 'label'])
        && f.name.matches('(?s).{1,200}')
        && f.label.matches('(?s).{0,200}')
        && f.storagePath.matches(prefix + '[A-Za-z0-9][A-Za-z0-9._-]{0,195}[.]pdf$');
    }

    // Saknad nyckel i f ger utvärderingsfel och därmed nekad skrivning (täcks av test). hasAll utelämnad: rules har ett
    // tak på antal uttryck per anrop och 8 filer ryms inte med den.
    // Rules saknar loopar: kontrollera varje plats för sig. Gränsen är 8 (MAX_COURSE_FILES).
    function validCourseFiles(l, eventId) {
      let prefix = '^courses/' + eventId + '/';
      return validCourseFilesIn(l, prefix);
    }

    function validCourseFilesIn(l, prefix) {
      return l is list && l.size() <= 8
        && (l.size() < 1 || validCourseFile(l[0], prefix))
        && (l.size() < 2 || validCourseFile(l[1], prefix))
        && (l.size() < 3 || validCourseFile(l[2], prefix))
        && (l.size() < 4 || validCourseFile(l[3], prefix))
        && (l.size() < 5 || validCourseFile(l[4], prefix))
        && (l.size() < 6 || validCourseFile(l[5], prefix))
        && (l.size() < 7 || validCourseFile(l[6], prefix))
        && (l.size() < 8 || validCourseFile(l[7], prefix));
    }

    function courseFilesOf(d) {
      return d.get('courseFiles', []);
    }

    // Huvudbild (valfri, äldre events saknar fältet): null eller { imageId, url, thumbnailUrl, alt } ur bildbanken.
    // url och thumbnailUrl måste vara bildbankens webb- respektive miniatyrfil (samma adressformat som imageBank-
    // posterna, https och bucketen okeken.firebasestorage.app, inga externa adresser), alt högst 300 tecken.
    // Fasta regexar i stället för att binda adresserna till imageId (som validImageFile gör): det sparar uttryck
    // under taket på 1000 per anrop, och en felparad bild kan bara visas fel, inte peka utanför bildbanken.
    // Att posten finns kontrolleras inte (en get till per anrop; en raderad bild ska inte låsa eventet).
    // keys() ger fel om i inte är en map och matches() om värdet saknas eller inte är en sträng, vilket nekar skrivningen.
    function eventImageOf(d) {
      return d.get('image', null);
    }

    function validEventImage(i) {
      return i == null
        || (i.keys().hasOnly(['imageId', 'url', 'thumbnailUrl', 'alt'])
          && i.alt.matches('(?s).{0,300}')
          && i.imageId.matches('[A-Za-z0-9]{1,64}')
          && i.url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/okeken[.]firebasestorage[.]app/o/image_bank%2F[A-Za-z0-9]{1,64}-web[.](jpg|png|webp)[?]alt=media&token=[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
          && i.thumbnailUrl.matches('https://firebasestorage[.]googleapis[.]com/v0/b/okeken[.]firebasestorage[.]app/o/image_bank%2F[A-Za-z0-9]{1,64}-thumbnail[.](jpg|png|webp)[?]alt=media&token=[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'));
    }

    // lat/lng är valfria men kommer alltid som par
    function validCoords(l) {
      return !('lat' in l) && !('lng' in l)
        || ('lat' in l) && ('lng' in l)
          && (l.lat is int || l.lat is float) && (l.lng is int || l.lng is float)
          && l.lat >= -90 && l.lat <= 90 && l.lng >= -180 && l.lng <= 180;
    }

    // Ikon för huvudplatsen och extra platser på kartan (valfria, äldre events saknar dem)
    function validPlaceIcon(i) {
      return i in ['start', 'parking', 'toilet', 'finish', 'gathering', 'water', 'firstaid', 'mailbox', 'other'];
    }

    function validPlace(p) {
      let lat = p.get('lat', null);
      let lng = p.get('lng', null);
      return p is map && p.keys().hasOnly(['icon', 'label', 'lat', 'lng'])
        && validPlaceIcon(p.get('icon', null))
        && p.get('label', null) is string && p.label.size() <= 100
        && lat is number && lat >= -90 && lat <= 90
        && lng is number && lng >= -180 && lng <= 180;
    }

    function validPlaces(ps) {
      return ps is list && ps.size() <= 3 && (ps.size() < 1 || validPlace(ps[0])) && (ps.size() < 2 || validPlace(ps[1]))
        && (ps.size() < 3 || validPlace(ps[2]));
    }

    // "Publicerat av": null eller medlemmens uid (valfritt fält, äldre events saknar det). Att medlemmen finns
    // kontrolleras inte; bygget visar bara medlemmar med members.publicName (beslut 0015).
    function publisherOf(d) {
      return d.get('publisher', null);
    }

    function validPublisher(p) {
      return p == null || (p is string && p.matches('[A-Za-z0-9]{1,128}'));
    }

    // Schemalagd publicering (beslut 0016): null eller tidpunkten då Function `publishScheduled` publicerar utkastet.
    // Ingår inte i ögonblicksbilden. Bara publicerare skriver det (banläggarregeln tillåter inte nyckeln).
    function validPublishAt(d) {
      let at = d.get('publishAt', null);
      return at == null || at is timestamp;
    }

    // Resultat på träningen (beslut 0017): bockruta som visar resultatvyn i admin. Ingår inte i ögonblicksbilden.
    function validResultsEnabled(d) {
      let on = d.get('resultsEnabled', null);
      return on == null || on is bool;
    }

    function validEventContent(d, eventId) {
      return d.type in ['training', 'competition', 'meeting', 'info', 'happening']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.startsAt is timestamp && d.endsAt is timestamp && d.endsAt >= d.startsAt
        && d.location is map && d.location.keys().hasOnly(['name', 'mapUrl', 'lat', 'lng', 'icon', 'places'])
        && d.location.name is string && d.location.name.size() <= 200
        && d.location.mapUrl is string && d.location.mapUrl.size() <= 500
        && (d.location.mapUrl == '' || d.location.mapUrl.matches('https://.*'))
        && validCoords(d.location)
        && validPlaceIcon(d.location.get('icon', 'start'))
        && validPlaces(d.location.get('places', []))
        && d.body is string && d.body.size() <= 20000
        && d.courseSetter is string && d.courseSetter.size() <= 200
        && d.livelox is string && d.livelox.size() <= 500
        && (d.livelox == '' || d.livelox.matches('https://.*'))
        && validCourseFiles(courseFilesOf(d), eventId)
        && validEventImage(eventImageOf(d))
        && validPublisher(publisherOf(d));
    }

    function eventSnapshot(d) {
      return {
        'type': d.type, 'title': d.title, 'startsAt': d.startsAt, 'endsAt': d.endsAt,
        'location': d.location, 'body': d.body, 'courseSetter': d.courseSetter, 'livelox': d.livelox,
        'courseFiles': courseFilesOf(d), 'image': eventImageOf(d), 'publisher': publisherOf(d)
      };
    }

    function validSlug(slug) {
      return slug is string && slug.size() <= 120 && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    // Banläggare (beslut 0006): får läsa events och ändra courseFiles, inget annat.
    function isCourseSetter() {
      return signedIn() && exists(userDoc())
        && 'course_setter' in get(userDoc()).data.permissions;
    }

    // Banläggarens skrivning: bara courseFiles (+ updatedBy/updatedAt). Är eventet publicerat får samma
    // skrivning lägga exakt utkastets courseFiles i `published` (resten av snapshoten och publishedAt orörda),
    // så att banorna går live vid nästa bygge utan att övriga utkastsändringar publiceras.
    // status/slug/publishedAt finns inte bland tillåtna nycklar, så de kan inte ändras här.
    function courseSetterUpdate(eventId) {
      let after = request.resource.data;
      let changed = after.diff(resource.data).affectedKeys();
      return changed.hasOnly(['courseFiles', 'updatedBy', 'updatedAt', 'published'])
        && after.updatedBy == request.auth.uid
        && after.updatedAt == request.time
        // Nyckeln måste finnas efter skrivningen (validCourseFiles ger fel på saknat fält)
        && validCourseFiles(after.courseFiles, eventId)
        && (!changed.hasAny(['published'])
          || (resource.data.status == 'published'
            && after.published is map
            && after.published.diff(resource.data.published).affectedKeys().hasOnly(['courseFiles'])
            && after.published.courseFiles == after.courseFiles));
    }

    match /events/{eventId} {
      allow read: if canPublish() || isCourseSetter();


      allow create: if canPublish()
        && request.resource.data.keys().hasOnly(eventKeys())
        && request.resource.data.keys().hasAll(requiredEventKeys())
        && validEventContent(request.resource.data, eventId)
        && request.resource.data.status == 'draft'
        && request.resource.data.slug == null
        && request.resource.data.published == null
        && request.resource.data.publishedAt == null
        && request.resource.data.source == 'manual'
        && validPublishAt(request.resource.data)
        && validResultsEnabled(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canPublish()
        && request.resource.data.keys().hasOnly(eventKeys())
        && request.resource.data.keys().hasAll(requiredEventKeys())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt', 'source'])
        && validPublishAt(request.resource.data)
        && validResultsEnabled(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        // Publicering: ögonblicksbilden ska vara exakt utkastet i samma skrivning
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['published', 'publishedAt'])
          || (request.resource.data.published == eventSnapshot(request.resource.data)
            && request.resource.data.publishedAt == request.time))
        // 'draft' bara för aldrig publicerade; publicerade/avpublicerade har ögonblicksbild och adress
        && (request.resource.data.status == 'draft'
          ? request.resource.data.published == null && request.resource.data.slug == null
          : request.resource.data.status in ['published', 'unpublished']
            && request.resource.data.published is map
            && validSlug(request.resource.data.slug))
        // Adressen låses vid första publiceringen (delade länkar ska fortsätta fungera)
        && (resource.data.publishedAt == null || request.resource.data.slug == resource.data.slug)
        // Innehållet (med upp till 8 banor och huvudbild) är dyrast och kontrolleras sist, så att en skrivning som ändå nekas
        // här inte förbrukar uttryckstaket innan banläggarregeln nedan prövas
        && validEventContent(request.resource.data, eventId);

      // Banläggare: bara banfiler (se courseSetterUpdate). Står efter publicerarregeln: taket på 1000 uttryck
      // gäller hela anropet, och publicerarregeln med 8 filer ligger nära taket.
      allow update: if isCourseSetter() && courseSetterUpdate(eventId);

      // Bara aldrig publicerade utkast får raderas; publicerade avpubliceras i stället
      allow delete: if canPublish() && resource.data.publishedAt == null;
    }

    // ---- Resultat på träningar (beslut 0017) ---------------------------------------------------
    // events/{eventId}/results/{entryId}: interna rader (startlista och resultat) som banläggare, publicerare,
    // styrelse och superadmin för in. Raden har ungdomsmarkering (`youth`, för LOK-stöd) och medlemslänk som aldrig
    // blir publika. Det publika är eventResultsPublished/{eventId}, som bara Function `setResultsPublished` skriver.
    function canManageResults() {
      return isCourseSetter() || canPublish();
    }

    function resultKeys() {
      return ['name', 'course', 'memberUid', 'startAt', 'finishAt', 'totalSeconds', 'youth', 'show',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'];
    }

    // rating och source skrivs bara av Function registerSelfResult (beslut 0022); personalens rader saknar dem
    function resultAllowedKeys() {
      return resultKeys().concat(['rating', 'source']);
    }

    function validResult(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.course is string && d.course.size() <= 100
        && (d.memberUid == null || (d.memberUid is string && d.memberUid.matches('[A-Za-z0-9]{1,128}')))
        && (d.startAt == null || d.startAt is timestamp)
        && (d.finishAt == null || d.finishAt is timestamp)
        && (d.totalSeconds == null || (d.totalSeconds is int && d.totalSeconds >= 0 && d.totalSeconds <= 86400))
        && d.youth is bool
        && d.show in ['time', 'participated', 'hidden']
        && (d.get('rating', null) == null || (d.rating is int && d.rating >= 1 && d.rating <= 5))
        && d.get('source', 'staff') in ['staff', 'member', 'guest'];
    }

    match /events/{eventId}/results/{entryId} {
      allow read, delete: if canManageResults();

      allow create: if canManageResults()
        && request.resource.data.keys().hasOnly(resultAllowedKeys())
        && request.resource.data.keys().hasAll(resultKeys())
        && validResult(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow update: if canManageResults()
        && request.resource.data.keys().hasOnly(resultAllowedKeys())
        && request.resource.data.keys().hasAll(resultKeys())
        && validResult(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Publicerad resultatlista: bara Admin SDK skriver. Läsning för de som sköter resultaten (status i adminvyn);
    // bygget läser med Admin SDK.
    match /eventResultsPublished/{eventId} {
      allow read: if canManageResults();
      allow write: if false;
    }

    // ---- Infosidor -------------------------------------------------------------------
    // Samma publiceringsmönster som events: utkastet är fälten på dokumentet, `published` är det som är live.
    // Bara publicerare, styrelse och superadmin har åtkomst (inte banläggare).

    // Menyplacering ligger i menu/main (beslut 0008), inte på sidorna.
    function pageKeys() {
      return ['title', 'body',
        'status', 'slug', 'published', 'publishedAt',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'];
    }

    function validPageContent(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.body is string && d.body.size() <= 50000;
    }

    function pageSnapshot(d) {
      return { 'title': d.title, 'body': d.body };
    }

    // Sidor serveras på /<slug> och får inte krocka med sajtens egna adresser.
    // Håll listan synkad med RESERVED_PAGE_SLUGS i src/lib/slug.ts.
    function reservedPageSlugs() {
      return ['event', 'admin', 'sok', 'logga-in', 'pagefind', 'api', 'assets', '404', 'index', 'kalender',
        'traningskalender', 'medlemsavgift'];
    }

    match /pages/{pageId} {
      allow read: if canPublish();

      allow create: if canPublish()
        && request.resource.data.keys().hasOnly(pageKeys())
        && request.resource.data.keys().hasAll(pageKeys())
        && validPageContent(request.resource.data)
        && request.resource.data.status == 'draft'
        && request.resource.data.slug == null
        && request.resource.data.published == null
        && request.resource.data.publishedAt == null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canPublish()
        && request.resource.data.keys().hasOnly(pageKeys())
        && request.resource.data.keys().hasAll(pageKeys())
        && validPageContent(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        // Publicering: ögonblicksbilden ska vara exakt utkastet i samma skrivning
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['published', 'publishedAt'])
          || (request.resource.data.published == pageSnapshot(request.resource.data)
            && request.resource.data.publishedAt == request.time))
        // 'draft' bara för aldrig publicerade; publicerade/avpublicerade har ögonblicksbild och adress
        && (request.resource.data.status == 'draft'
          ? request.resource.data.published == null && request.resource.data.slug == null
          : request.resource.data.status in ['published', 'unpublished']
            && request.resource.data.published is map
            && validSlug(request.resource.data.slug)
            // Reserverade adresser kontrolleras när slug sätts (en senare reserverad adress låser inte en befintlig sida)
            && (request.resource.data.slug == resource.data.slug
              || !(request.resource.data.slug in reservedPageSlugs())))
        // Adressen låses vid första publiceringen (menyn och andra sidor länkar till den)
        && (resource.data.publishedAt == null || request.resource.data.slug == resource.data.slug);

      // Bara aldrig publicerade utkast får raderas; publicerade avpubliceras i stället
      allow delete: if canPublish() && resource.data.publishedAt == null;
    }

    // ---- Huvudmeny (beslut 0008) -------------------------------------------------------
    // Ett dokument, menu/main. `items` är utkastet, `published` = { items } är det som är live (bygget läser
    // bara det). Ingen status: "Publicera" kopierar utkastet till `published` i samma skrivning. Kalendern är
    // fast första post och lagras inte. Bara publicerare, styrelse och superadmin (inte banläggare).
    //
    // items: högst 8 poster { label, pageId, children }, label 1–40 tecken, pageId = id i pages eller null
    // (rubrik utan egen sida). children: högst 8 sid-id:n (strängar), ingen tredje nivå. En sida får förekomma högst
    // en gång i hela menyn. Att sidan finns och är publicerad kan reglerna inte kontrollera (för många get);
    // bygget hoppar tyst över sådana poster och adminvyn varnar.
    //
    // Rules saknar loopar: posterna kontrolleras plats för plats, som validCourseFiles, medan alla sid-id:n
    // valideras tillsammans med en regex. Barnen är därför strängar, inte { pageId }-mappar: en kontroll per
    // barn i en full meny (8 × 8) slog i taket på 1000 uttryck per anrop. Testerna "full meny" i
    // tests/rules/menu.test.ts bevakar taket.

    // Sid-id:n kontrolleras i validMenuPages. Saknad nyckel ger utvärderingsfel och därmed nekad skrivning (keys() ger fel om i inte är en map).
    function validMenuItem(i) {
      return i.keys().hasOnly(['label', 'pageId', 'children'])
        && i.label.matches('(?s).{1,40}')
        && (i.pageId == null || i.pageId is string)
        && i.children is list && i.children.size() <= 8;
    }

    // Postens alla sid-id:n
    function menuItemPages(i) {
      return i.pageId == null ? i.children : i.children.concat([i.pageId]);
    }

    function menuPages(l) {
      return (l.size() < 1 ? [] : menuItemPages(l[0]))
        .concat(l.size() < 2 ? [] : menuItemPages(l[1]))
        .concat(l.size() < 3 ? [] : menuItemPages(l[2]))
        .concat(l.size() < 4 ? [] : menuItemPages(l[3]))
        .concat(l.size() < 5 ? [] : menuItemPages(l[4]))
        .concat(l.size() < 6 ? [] : menuItemPages(l[5]))
        .concat(l.size() < 7 ? [] : menuItemPages(l[6]))
        .concat(l.size() < 8 ? [] : menuItemPages(l[7]));
    }

    // Varje sid-id 1–128 tecken av A–Z a–z 0–9 _ - och ingen sida två gånger, kontrollerat på en gång.
    // join() gör om tal/null till text, så split-resultatet jämförs med originalet: det skiljer sig om ett
    // element inte är en sträng eller själv innehåller ett kommatecken.
    function validMenuPages(l) {
      let all = menuPages(l);
      let joined = all.join(',');
      return all.size() == 0
        || (joined.matches('^[A-Za-z0-9_-]{1,128}(,[A-Za-z0-9_-]{1,128})*$')
          && joined.split(',') == all
          && all.toSet().size() == all.size());
    }

    function validMenuItems(l) {
      return l is list && l.size() <= 8
        && (l.size() < 1 || validMenuItem(l[0]))
        && (l.size() < 2 || validMenuItem(l[1]))
        && (l.size() < 3 || validMenuItem(l[2]))
        && (l.size() < 4 || validMenuItem(l[3]))
        && (l.size() < 5 || validMenuItem(l[4]))
        && (l.size() < 6 || validMenuItem(l[5]))
        && (l.size() < 7 || validMenuItem(l[6]))
        && (l.size() < 8 || validMenuItem(l[7]))
        && validMenuPages(l);
    }

    function menuKeys() {
      return ['items', 'published', 'publishedAt', 'updatedBy', 'updatedAt'];
    }

    match /menu/main {
      allow read: if canPublish();

      // Första sparningen skapar dokumentet, som utkast eller direkt publicerat
      allow create: if canPublish()
        && request.resource.data.keys().hasOnly(menuKeys())
        && request.resource.data.keys().hasAll(menuKeys())
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.published == null && request.resource.data.publishedAt == null)
          || (request.resource.data.published == { 'items': request.resource.data.items }
            && request.resource.data.publishedAt == request.time))
        && validMenuItems(request.resource.data.items);

      allow update: if canPublish()
        && request.resource.data.keys().hasOnly(menuKeys())
        && request.resource.data.keys().hasAll(menuKeys())
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        // Publicering: ögonblicksbilden ska vara exakt utkastet i samma skrivning (null går inte att återställa;
        // en tom meny publiceras som { items: [] })
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['published', 'publishedAt'])
          || (request.resource.data.published == { 'items': request.resource.data.items }
            && request.resource.data.publishedAt == request.time))
        && validMenuItems(request.resource.data.items);

      // Menyn töms genom att publicera en tom lista, inte genom radering (som skulle gå live utan publicering)
      allow delete: if false;
    }

    // ---- Bildbank (beslut 0007) -------------------------------------------------------
    // En post per bild med tre filer i Storage: image_bank/<imageId>-<original|web|thumbnail>.<jpg|png|webp>.
    // Sökvägar och URL:er binds till postens eget id, så en post kan bara peka på sina egna filer i
    // bildbankens mapp (inte courses/, inte andra posters filer, inte externa adresser/spårpixlar).
    // Bara publicerare, styrelse och superadmin. Efter skapandet får bara name/byline/description ändras.

    function imageBankKeys() {
      return ['name', 'url', 'webUrl', 'thumbnailUrl', 'byline', 'description', 'storagePaths',
        'size', 'type', 'uploadedBy', 'createdAt'];
    }

    function validImageMeta(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.byline is string && d.byline.size() <= 200
        && d.description is string && d.description.size() <= 300;
    }

    // path: image_bank/<imageId>-<variant>.<ext>. url: bucketens nedladdningsadress för exakt den filen
    // (Storage kodar '/' som %2F) med token från getDownloadURL och inget annat. imageId är redan kontrollerat
    // till [A-Za-z0-9] och kan därför sättas in i regexen.
    function validImageFile(url, path, imageId, variant) {
      return path is string && path.size() <= 300
        && path.matches('^image_bank/' + imageId + '-' + variant + '[.](jpg|png|webp)$')
        && url is string && url.size() <= 1000
        && url.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/okeken[.]firebasestorage[.]app/o/image_bank%2F'
          + imageId + '-' + variant + '[.]' + path.split('[.]')[1]
          + '[?]alt=media&token=[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    match /imageBank/{imageId} {
      allow read: if canPublish();

      allow create: if imageId.matches('^[A-Za-z0-9]{1,64}$')
        && canPublish()
        && request.resource.data.keys().hasOnly(imageBankKeys())
        && request.resource.data.keys().hasAll(imageBankKeys())
        && validImageMeta(request.resource.data)
        && request.resource.data.storagePaths is map
        && request.resource.data.storagePaths.keys().hasOnly(['original', 'web', 'thumbnail'])
        && request.resource.data.storagePaths.keys().hasAll(['original', 'web', 'thumbnail'])
        && validImageFile(request.resource.data.url, request.resource.data.storagePaths.original, imageId, 'original')
        && validImageFile(request.resource.data.webUrl, request.resource.data.storagePaths.web, imageId, 'web')
        && validImageFile(request.resource.data.thumbnailUrl, request.resource.data.storagePaths.thumbnail, imageId, 'thumbnail')
        // size och type gäller filen som användaren valde (kan vara större än det som lagras, se src/types/image.ts)
        && request.resource.data.size is int
        && request.resource.data.size >= 0 && request.resource.data.size <= 30 * 1024 * 1024
        && request.resource.data.type in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Bara metadata (namn, fotograf, alt-text); filer och URL:er är låsta
      allow update: if canPublish()
        && onlyChanges(['name', 'byline', 'description'])
        && validImageMeta(request.resource.data);

      // Radera posten först, sedan filerna (storage.rules tillåter bara radering av filer utan post)
      allow delete: if canPublish();
    }

    // ---- Styrelsens protokoll (beslut 0009) ------------------------------------------
    // Internt: bara styrelse och superadmin får läsa och skriva. Bygget läser aldrig collectionen (beslut 0004).
    // Godkännanden: sekreterarens och justerarens godkännande är var sitt fält med servertid (eller null).
    // När båda är satta är protokollet låst: ingen ändring, ingen radering. Innehållsändringar (allt utom
    // godkännandena) går bara på olåsta protokoll och nollställer båda godkännandena i samma skrivning, så ett
    // godkännande gäller exakt den text som godkändes. Ingen status lagras; den härleds ur godkännandena
    // (src/lib/protocol.ts).
    //
    // Tak: högst 10 närvarande och 8 att göra-punkter (MAX_ATTENDEES/MAX_TODOS i src/types/protocol.ts).
    // Rules saknar loopar, så posterna kontrolleras plats för plats. Taket på 1000 uttryck per anrop räcker inte
    // till fler: varje operator och funktionsanrop räknas, och en att göra-punkt kostar ungefär lika mycket som
    // 1,5 deltagare. Mätt (innehållsändring av sekreteraren, dyraste vägen, maxlängd på alla texter): 10 deltagare
    // + 9 punkter går igenom, alltså en punkt i marginal. Testet "fullt protokoll" i tests/rules/protocols.test.ts
    // bevakar taket. Unikhet för uid:n och id:n kontrolleras inte här (att samla värdena i en lista för join +
    // regex/toSet kostade mer än det ryms); klienten säkerställer den (validateProtocol i src/lib/protocol.ts).
    //
    // Att taggade uid finns i users kontrolleras inte (en get per uid ryms inte i gränsen för dokumentläsningar).
    // Sekreterare och justerare bevisar sin identitet när de godkänner (de måste vara inloggade som den uid:n och
    // ha styrelsebehörighet), så ett protokoll med fel uid kan inte låsas. Omnämnanden i body (@[Namn](mention:uid))
    // är vanlig text för reglerna, som bara begränsar längden.

    function canViewProtocols() {
      return signedIn() && exists(userDoc())
        && get(userDoc()).data.permissions.hasAny(['board', 'superadmin']);
    }

    // Dokumentets 15 nycklar: meetingAt, location, body, attendees, todos, secretaryUid, secretaryName, adjusterUid,
    // adjusterName, secretaryApprovedAt, adjusterApprovedAt, createdBy, createdAt, updatedBy, updatedAt.
    // Reglerna kräver size() == 15 i stället för keys().hasOnly/hasAll([...]): create och innehållsändringen läser
    // alla 15 (en saknad nyckel ger utvärderingsfel och nekad skrivning), så rätt antal betyder exakt rätt nycklar.
    // Det sparar uttryck under taket. Håll antalet synkat om en nyckel läggs till.
    function protocolKeyCount() {
      return 15;
    }

    // Närvarande deltagare { uid, name } (frånvarande noteras inte). Samma knep per post: alla nycklar läses
    // nedan, så size() == N betyder exakt rätt nycklar. matches() ger fel om värdet inte är en sträng och
    // .uid m.fl. ger fel om posten inte är en map, vilket nekar skrivningen.
    function validAttendee(a) {
      return a.size() == 2
        && a.uid.matches('[A-Za-z0-9_-]{1,128}')
        && a.name.matches('(?s).{1,200}');
    }

    // Att göra { id, text, assigneeUid, assigneeName, done }: id är klientens eget stabila id (för att senare
    // kunna lyftas ut till personliga att göra-listor), assigneeUid null = ingen ansvarig.
    function validTodo(t) {
      return t.size() == 5
        && t.id.matches('[A-Za-z0-9_-]{1,64}')
        && t.text.matches('(?s).{1,300}')
        && (t.assigneeUid == null || t.assigneeUid.matches('[A-Za-z0-9_-]{1,128}'))
        && t.assigneeName.matches('(?s).{0,200}')
        && t.done is bool;
    }

    function validAttendees(l) {
      let n = l.size();
      return l is list && n <= 10
        && (n < 1 || validAttendee(l[0]))
        && (n < 2 || validAttendee(l[1]))
        && (n < 3 || validAttendee(l[2]))
        && (n < 4 || validAttendee(l[3]))
        && (n < 5 || validAttendee(l[4]))
        && (n < 6 || validAttendee(l[5]))
        && (n < 7 || validAttendee(l[6]))
        && (n < 8 || validAttendee(l[7]))
        && (n < 9 || validAttendee(l[8]))
        && (n < 10 || validAttendee(l[9]));
    }

    function validTodos(l) {
      let n = l.size();
      return l is list && n <= 8
        && (n < 1 || validTodo(l[0]))
        && (n < 2 || validTodo(l[1]))
        && (n < 3 || validTodo(l[2]))
        && (n < 4 || validTodo(l[3]))
        && (n < 5 || validTodo(l[4]))
        && (n < 6 || validTodo(l[5]))
        && (n < 7 || validTodo(l[6]))
        && (n < 8 || validTodo(l[7]));
    }

    // Sekreterare och justerare: uid eller null (inte utsedd än), aldrig samma person
    function validProtocolContent(d) {
      return d.meetingAt is timestamp
        && d.location is string && d.location.size() <= 200
        && d.body is string && d.body.size() <= 50000
        && (d.secretaryUid == null || d.secretaryUid.matches('[A-Za-z0-9_-]{1,128}'))
        && (d.adjusterUid == null || d.adjusterUid.matches('[A-Za-z0-9_-]{1,128}'))
        && (d.secretaryUid == null || d.secretaryUid != d.adjusterUid)
        && d.secretaryName.matches('(?s).{0,200}')
        && d.adjusterName.matches('(?s).{0,200}')
        && validAttendees(d.attendees)
        && validTodos(d.todos);
    }

    function protocolLocked(d) {
      return d.secretaryApprovedAt != null && d.adjusterApprovedAt != null;
    }

    // Innehållsändring: båda godkännandena nollställs i samma skrivning. Kontrollen av godkännandena står
    // först, så att en godkännande-skrivning nekas här innan innehållet (det dyra) valideras.
    function protocolContentUpdate() {
      let after = request.resource.data;
      return after.secretaryApprovedAt == null && after.adjusterApprovedAt == null
        && after.size() == protocolKeyCount()
        && !after.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt'])
        && after.updatedBy == request.auth.uid
        && after.updatedAt == request.time
        && validProtocolContent(after);
    }

    // Godkännande eller tillbakadragande av egen del: bara den utsedda personen, bara det egna fältet, inget annat
    // i dokumentet ändras (inte heller updatedBy/updatedAt). Godkännande = servertid, tillbakadragande = null.
    function protocolApproval(field, approverUid) {
      let before = resource.data;
      let after = request.resource.data;
      return approverUid != null
        && approverUid == request.auth.uid
        && before.secretaryUid != before.adjusterUid
        && onlyChanges([field])
        && ((before[field] == null && after[field] == request.time)
          || (before[field] != null && after[field] == null));
    }

    match /protocols/{protocolId} {
      allow read: if canViewProtocols();

      // Nytt protokoll är alltid ett utkast utan godkännanden
      allow create: if canViewProtocols()
        && request.resource.data.size() == protocolKeyCount()
        && request.resource.data.secretaryApprovedAt == null
        && request.resource.data.adjusterApprovedAt == null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validProtocolContent(request.resource.data);

      // Låst protokoll ändras aldrig; rättelser görs som nytt protokoll
      allow update: if canViewProtocols()
        && !protocolLocked(resource.data)
        // Innehållsändringen prövas först: den är den dyra, och står den sist får sekreterarens/justerarens egna
        // ändringar betala för godkännandegrenarna också. En godkännande-skrivning nekas där på första raden.
        && (protocolContentUpdate()
          || protocolApproval('secretaryApprovedAt', resource.data.secretaryUid)
          || protocolApproval('adjusterApprovedAt', resource.data.adjusterUid));

      // Bara utkast utan något godkännande
      allow delete: if canViewProtocols()
        && resource.data.secretaryApprovedAt == null
        && resource.data.adjusterApprovedAt == null;
    }

    // ---- Medlemsavgift och medlemsbetalningar (beslut 0020) ------------------------------
    // membershipFees/{år}: avgiftstabellen. Publik läsning (priserna visas för alla), bara styrelse och superadmin skriver.
    // membershipPayments/{id}: skapas av Function createMembershipPayment (Admin SDK) när någon betalar via sajten, och
    // av styrelsen för betalningar som registreras för hand. Läsning: styrelse, superadmin och den inloggade som
    // betalningen är kopplad till. Bara styrelse och superadmin ändrar status. Beloppet räknas av Functionen, inte här.
    function canManageMembership() {
      return signedIn() && exists(userDoc())
        && get(userDoc()).data.permissions.hasAny(['board', 'superadmin']);
    }

    function validFees(d) {
      return d.keys().hasOnly(['year', 'swishNumber', 'categories', 'family', 'updatedBy', 'updatedAt'])
        && d.year is int && d.year == int(yearOf(d))
        && d.swishNumber is string && d.swishNumber.matches('^[0-9]{0,15}$')
        && d.categories is list && d.categories.size() <= 8
        && (d.family == null || (d.family is map && d.family.amount is int && d.family.amount >= 0
          && d.family.amount <= 100000 && d.family.minPeople is int && d.family.minPeople >= 2
          && d.family.minPeople <= 12
          && d.family.maxAdults is int && d.family.maxAdults >= 1 && d.family.maxAdults <= 12))
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    function yearOf(d) {
      return string(d.year);
    }

    function validPaymentChange() {
      let d = request.resource.data;
      return d.status in ['pending', 'paid', 'cancelled']
        && d.amount is int && d.amount >= 0 && d.amount <= 100000
        && d.year is int && d.year >= 2020 && d.year <= 2100
        && d.payerName is string && d.payerName.size() >= 1 && d.payerName.size() <= 100
        && d.people is list && d.people.size() <= 12
        && d.note is string && d.note.size() <= 500;
    }

    match /membershipFees/{year} {
      allow read: if true;
      allow create, update: if canManageMembership()
        && year.matches('^20[0-9]{2}$')
        && request.resource.data.year == int(year)
        && validFees(request.resource.data);
      allow delete: if canManageMembership();
    }

    match /membershipPayments/{id} {
      allow read: if canManageMembership()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if canManageMembership()
        && request.resource.data.keys().hasOnly(['year', 'reference', 'payerName', 'payerEmail', 'uid', 'people', 'amount',
          'status', 'source', 'note', 'createdAt', 'createdBy', 'updatedAt', 'paidAt', 'paidBy'])
        && request.resource.data.source == 'manual'
        && request.resource.data.createdBy == request.auth.uid
        && validPaymentChange();
      // Styrelsen ändrar status, anteckning och betaltid; personer, belopp och referens ligger fast
      allow update: if canManageMembership()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'paidAt', 'paidBy', 'updatedAt'])
        && validPaymentChange();
      allow delete: if canManageMembership() && resource.data.status != 'paid';
    }

    // ---- Eventor-spegel ----------------------------------------------------------------
    // eventorEvents är en spegel av Eventor (beslut: ingen egen event-post). Eventor-fälten skrivs bara av
    // synkskriptet (Admin SDK). Publicerare kryssar i/ur `selected` (utkast) och trycker sedan Publicera, som sätter
    // `live` = `selected`. Bara `live` når besökarna (som published på events).
    match /eventorEvents/{eventId} {
      allow read: if canPublish();
      allow create, delete: if false;
      allow update: if canPublish() && (
        (onlyChanges(['selected', 'selectedBy', 'selectedAt'])
          && request.resource.data.selected is bool
          && request.resource.data.selectedBy == request.auth.uid
          && request.resource.data.selectedAt == request.time)
        || (onlyChanges(['live', 'liveBy', 'liveAt'])
          && request.resource.data.live == request.resource.data.selected
          && request.resource.data.liveBy == request.auth.uid
          && request.resource.data.liveAt == request.time));
    }

    // Urvalsregler för synken. Styrelse och superadmin ändrar, publicerare läser.
    match /settings/eventor {
      allow read: if canPublish();
      allow write: if (has('board') || has('superadmin'))
        && request.resource.data.keys().hasOnly(['ownOrganisationId', 'organisationIds', 'classificationIds',
          'disciplineIds', 'monthsAhead', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['ownOrganisationId', 'organisationIds', 'classificationIds',
          'disciplineIds', 'monthsAhead', 'updatedBy', 'updatedAt'])
        && request.resource.data.ownOrganisationId is int
        && request.resource.data.organisationIds is list
        && request.resource.data.organisationIds.size() >= 1 && request.resource.data.organisationIds.size() <= 10
        && request.resource.data.classificationIds is list
        && request.resource.data.classificationIds.size() <= 6
        && request.resource.data.classificationIds.toSet().hasOnly([0, 1, 2, 3, 4, 5])
        && request.resource.data.disciplineIds is list
        && request.resource.data.disciplineIds.size() <= 10
        && request.resource.data.monthsAhead is int
        && request.resource.data.monthsAhead >= 1 && request.resource.data.monthsAhead <= 24
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // ---- Bygge ---------------------------------------------------------------------
    // meta/build.lastBuildAt skrivs bara av Actions (Admin SDK). Editorn läser den för delningsknappen.
    match /meta/build {
      allow read: if canPublish();
      allow write: if false;
    }

    // ---- Medlemslista (beslut 0015, 0018) --------------------------------------------------------
    // members/{uid}: namn, profilbild, om namnet får visas publikt och om personen valt "Dölj mig". Skrivs bara av
    // Function `onUserMemberWritten`. Banläggare, publicerare, styrelse och superadmin läser alla (namnsökning i
    // resultat, "publicerat av"; need to know). Vanliga medlemmar läser bara dem som inte är dolda (en listfråga måste
    // ha where('hidden', '==', false)) och sig själva. Alla inloggade läser den de har en konversation med (även en dold
    // person som skrivit till dem), så att namnet kan visas i meddelandena.

    function canSeeHidden() {
      return isCourseSetter() || canPublish();
    }

    // Konversationens id: de två uid:na i ordning, åtskilda med understreck (beslut 0019)
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    match /members/{uid} {
      allow read: if canSeeHidden()
        || (signedIn() && exists(/databases/$(database)/documents/conversations/$(pairId(request.auth.uid, uid))))
        || (isMember() && (resource.data.hidden == false || uid == request.auth.uid));
      allow write: if false;
    }

    // ---- Meddelanden (beslut 0019) ---------------------------------------------------------------
    // conversations/{a_b}: en konversation per par, med uid:na i ordning. Dokumentet har `participants`, en kort
    // sammanfattning av senaste meddelandet och `readAt` (när var och en senast läste). conversations/{id}/messages/{id}
    // är själva meddelandena (oföränderliga). Avsändaren är alltid den inloggade. Bara deltagarna läser.
    // Nya konversationer startas av medlemmar mot den som inte är dold (banläggare och uppåt kan nå alla, de ser dem
    // ändå); att svara i en befintlig konversation kräver bara att man är deltagare.

    function recipientAllowed(other) {
      return exists(/databases/$(database)/documents/users/$(other))
        && (canSeeHidden() || get(/databases/$(database)/documents/users/$(other)).data.get('hidden', false) == false);
    }

    function validNewConversation(id) {
      let d = request.resource.data;
      let me = request.auth.uid;
      return d.keys().hasOnly(['participants', 'lastMessageAt', 'lastSenderUid', 'lastText', 'readAt'])
        && d.participants is list && d.participants.size() == 2
        && me in d.participants
        && d.participants[0] != d.participants[1]
        && id == pairId(d.participants[0], d.participants[1])
        && d.lastSenderUid == me
        && d.lastMessageAt == request.time
        && d.lastText is string && d.lastText.size() <= 200
        && d.readAt.keys().hasOnly([me])
        && d.readAt[me] == request.time;
    }

    match /conversations/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if isMember()
        && validNewConversation(id)
        && recipientAllowed(request.resource.data.participants.removeAll([request.auth.uid])[0]);

      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.readAt.diff(resource.data.readAt).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.readAt[request.auth.uid] == request.time
        && (
          // Markera som läst
          onlyChanges(['readAt'])
          // Skicka ett nytt meddelande (skrivs i samma batch som meddelandet)
          || (onlyChanges(['lastMessageAt', 'lastSenderUid', 'lastText', 'readAt'])
            && request.resource.data.lastSenderUid == request.auth.uid
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 200)
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants;

        allow create: if signedIn()
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(id)).data.participants
          && getAfter(/databases/$(database)/documents/conversations/$(id)).data.lastMessageAt == request.time
          && getAfter(/databases/$(database)/documents/conversations/$(id)).data.lastSenderUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'kind', 'link', 'createdAt'])
          && request.resource.data.keys().hasAll(['senderUid', 'text', 'kind', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.kind == 'text' && !('link' in request.resource.data))
            // Automatiskt meddelande om en ändring (ny behörighet, ny ansvarig …), bara från dem som gör sådana ändringar
            || (request.resource.data.kind == 'notice' && canSeeHidden()
              && (!('link' in request.resource.data)
                || (request.resource.data.link is string && request.resource.data.link.matches('^/[^/].*') && request.resource.data.link.size() <= 200)))
          );

        allow update, delete: if false;
      }
    }

    // ---- Besöksstatistik (beslut 0014) -----------------------------------------------------
    // statsPages/{datum}__{sida} och statsDownloads/{datum}__{sida|fil}: dagliga räknare som bara Cloud Function
    // `hit` skriver (Admin SDK). Publicerare, styrelse och superadmin läser. statsSeen (hashar för unika besökare)
    // är aldrig läsbar eller skrivbar från klienten.
    match /statsPages/{id} {
      allow read: if canPublish();
      allow write: if false;
    }
    match /statsDownloads/{id} {
      allow read: if canPublish();
      allow write: if false;
    }
    match /statsSeen/{id} {
      allow read, write: if false;
    }

    // ---- Svar på events (Kommer / Kommer kanske / Kommer inte) -------------------------
    // rsvps/{slug}/responses/{uid}: ett svar per användare, dokument-id = uid. Bara inloggade med minst en
    // behörighet (medlem eller högre) får läsa och svara; besökare ser aldrig svar. `name` är användarens
    // visningsnamn, eller '' när användaren dolt sitt namn (antalet räknas ändå och styrelsen ser vem via uid).
    // Slug är eventets stabila adress; att eventet finns kontrolleras inte (en get per svar, se beslut 0012).

    function isMember() {
      return signedIn() && exists(userDoc()) && get(userDoc()).data.permissions.size() > 0;
    }

    match /rsvps/{slug}/responses/{uid} {
      allow read: if isMember();

      allow create, update: if isMember()
        && request.auth.uid == uid
        && validSlug(slug)
        && request.resource.data.keys().hasOnly(['status', 'name', 'updatedAt'])
        && request.resource.data.keys().hasAll(['status', 'name', 'updatedAt'])
        && request.resource.data.status in ['yes', 'maybe', 'no']
        && request.resource.data.name is string
        && (request.resource.data.name == '' || request.resource.data.name == get(userDoc()).data.displayName)
        && request.resource.data.name.size() <= 100
        && request.resource.data.updatedAt == request.time;

      allow delete: if isMember() && request.auth.uid == uid;
    }

    // ---- Användare ---------------------------------------------------------------

    // Profilfärg (väljs ur en fast palett, se src/lib/avatar.ts) och profilbild (egen Storage-fil avatars/<uid>.jpg)
    function avatarColors() {
      return ['purple', 'green', 'gold', 'blue', 'red', 'teal', 'orange', 'grey'];
    }

    function validPhotoUrl(url, uid) {
      return url == ''
        || (url is string && url.size() <= 1000
          && url.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/[^/]+/o/avatars%2F' + uid + '[.]jpg[?].*$'));
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || has('board') || has('superadmin'));

      // Första inloggningen: eget dokument utan behörigheter. Kräver bekräftad e-post
      // (Google och e-postlänk är det direkt; lösenordskonton efter bekräftelsemejlet),
      // så att ingen kan registrera sig med någon annans adress och få dennes roller.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'permissions', 'createdAt'])
        && request.resource.data.permissions == []
        && request.resource.data.email == request.auth.token.email
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && (
        // Användaren själv: profil och inställningar (aldrig behörigheter). E-post bara när den följt efter ett
        // bekräftat e-postbyte i inloggningen (samma som token), så att users.email inte kan peka på någon annan.
        (request.auth.uid == uid
          && onlyChanges(['displayName', 'avatarColor', 'photoUrl', 'hidden', 'email'])
          && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
          && (!('avatarColor' in request.resource.data) || request.resource.data.avatarColor in avatarColors())
          && (!('photoUrl' in request.resource.data) || validPhotoUrl(request.resource.data.photoUrl, uid))
          && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool)
          && (request.resource.data.email == resource.data.email
            || (request.auth.token.email_verified == true && request.resource.data.email == request.auth.token.email)))
        // Användaren själv: ta tillbaka godkännandet av integritetspolicyn (tar bort fältet)
        || (request.auth.uid == uid
          && onlyChanges(['consent'])
          && !('consent' in request.resource.data))
        // Användaren själv: godkännande av integritetspolicyn (version + tidpunkt från servern)
        || (request.auth.uid == uid
          && onlyChanges(['consent'])
          && request.resource.data.consent is map
          && request.resource.data.consent.keys().hasOnly(['version', 'acceptedAt'])
          && request.resource.data.consent.version is string
          && request.resource.data.consent.version.size() <= 20
          && request.resource.data.consent.acceptedAt == request.time)
        // Superadmin: alla behörigheter
        || (has('superadmin')
          && onlyChanges(['permissions'])
          && validPermissions(request.resource.data.permissions)
          && keepsOwnSuperadmin(uid))
        // Styrelse: allt utom superadmin (även ta bort sin egen styrelse)
        || (has('board')
          && onlyChanges(['permissions'])
          && validPermissions(request.resource.data.permissions)
          && changedPermissions().hasOnly(boardAssignable()))
      );

      allow delete: if false;
    }
  }
}
