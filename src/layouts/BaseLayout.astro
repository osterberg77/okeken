---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  /** Rubrik för delning (Open Graph); standard är `title` */
  ogTitle?: string;
  ogType?: 'website' | 'article';
  /** Admin- och inloggningssidor ska inte indexeras */
  noindex?: boolean;
  /**
   * Delningsbild (og:image): absolut https-adress till en JPEG/PNG/WebP, t.ex. eventets huvudbild (bildbankens
   * webbversion, 1920 px). Utan bild används /og-default.png (logotypen).
   */
  ogImage?: { url: string; alt: string };
}

const { title, description = 'OK Eken – orienteringsklubb i Åtvidaberg', ogTitle = title, ogType = 'website', noindex = false, ogImage } = Astro.props;
// build.format 'file' ger '/event/x.html'; Hosting (cleanUrls) serverar '/event/x'
// Utan egen huvudbild delas klubbens logotyp (public/og-default.png, 1200x630)
const shareImage = ogImage ?? { url: new URL('/og-default.png', Astro.site).href, alt: 'OK Eken Åtvidaberg' };
const canonicalPath = Astro.url.pathname.replace(/(index)?\.html$/, '');
const canonical = new URL(canonicalPath, Astro.site).href;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta property="og:site_name" content="OK Eken" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage.url} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage.url} />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    {/* Besöksräknare (beslut 0014): inga kakor, ingen IP sparas. Inte på admin-/inloggningssidor. Inloggade räknas med en
        ja/nej-flagga (kontoknappens cache finns i localStorage) så att vi kan se andelen. Dev-servern räknar inte. */}
    {!noindex && import.meta.env.PROD && (
      <script is:inline>{`
(function () {
  // Inloggad medlem? (kontoknappens cache). Bara ja/nej skickas, aldrig vem det är.
  var member = 0;
  try { if (localStorage.getItem('okeken:avatar')) member = 1; } catch (e) {}
  function send(d) {
    d.m = member;
    try { navigator.sendBeacon('/api/hit', new Blob([JSON.stringify(d)], { type: 'text/plain' })); } catch (e) {}
  }
  var path = location.pathname;
  send({ t: 'pv', p: path, r: document.referrer });
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest && e.target.closest('a[href]');
    if (!a) return;
    var file;
    try { file = decodeURIComponent(new URL(a.href, location.href).pathname).split('/').pop(); } catch (x) { return; }
    if (file && /\.(pdf|docx?|xlsx?|pptx?|zip|gpx|png|jpe?g)$/i.test(file)) send({ t: 'dl', p: path, f: file });
  }, true);
})();
`}</script>
    )}
  </head>
  <body class="bg-canvas font-sans text-[15px] leading-normal text-ink antialiased">
    <a href="#innehall" class="skip-link">Hoppa till innehåll</a>
    {/* overflow-x-clip (inte overflow-hidden): klipper de dekorativa cirklarna i sidled men inte menyernas rullgardiner */}
    <div class="relative flex min-h-screen flex-col overflow-x-clip">
      <div aria-hidden="true" class="pointer-events-none absolute -top-[180px] -right-[120px] h-[560px] w-[560px] rounded-full bg-[radial-gradient(circle,rgba(164,112,190,.22),rgba(164,112,190,0)_70%)]"></div>
      <div aria-hidden="true" class="pointer-events-none absolute top-[420px] -left-[200px] h-[520px] w-[520px] rounded-full bg-[radial-gradient(circle,rgba(170,205,160,.25),rgba(170,205,160,0)_70%)]"></div>
      <Header />
      <div class="relative flex-1">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>
