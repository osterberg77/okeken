---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  /** Rubrik för delning (Open Graph); standard är `title` */
  ogTitle?: string;
  ogType?: 'website' | 'article';
  /** Admin- och inloggningssidor ska inte indexeras */
  noindex?: boolean;
  /**
   * Delningsbild (og:image): absolut https-adress till en JPEG/PNG/WebP, t.ex. eventets huvudbild (bildbankens
   * webbversion, 1920 px). Utan bild sätts ingen og:image (logotypen finns bara som SVG, som Facebook inte visar).
   */
  ogImage?: { url: string; alt: string };
}

const { title, description = 'OK Eken – orienteringsklubb i Åtvidaberg', ogTitle = title, ogType = 'website', noindex = false, ogImage } = Astro.props;
// build.format 'file' ger '/event/x.html'; Hosting (cleanUrls) serverar '/event/x'
const canonicalPath = Astro.url.pathname.replace(/(index)?\.html$/, '');
const canonical = new URL(canonicalPath, Astro.site).href;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta property="og:site_name" content="OK Eken" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage.url} />}
    {ogImage?.alt && <meta property="og:image:alt" content={ogImage.alt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {ogImage && <meta name="twitter:image" content={ogImage.url} />}
    {ogImage?.alt && <meta name="twitter:image:alt" content={ogImage.alt} />}
  </head>
  <body class="bg-canvas font-sans text-[15px] leading-normal text-ink antialiased">
    {/* overflow-x-clip (inte overflow-hidden): klipper de dekorativa cirklarna i sidled men inte menyernas rullgardiner */}
    <div class="relative flex min-h-screen flex-col overflow-x-clip">
      <div aria-hidden="true" class="pointer-events-none absolute -top-[180px] -right-[120px] h-[560px] w-[560px] rounded-full bg-[radial-gradient(circle,rgba(164,112,190,.22),rgba(164,112,190,0)_70%)]"></div>
      <div aria-hidden="true" class="pointer-events-none absolute top-[420px] -left-[200px] h-[520px] w-[520px] rounded-full bg-[radial-gradient(circle,rgba(170,205,160,.25),rgba(170,205,160,0)_70%)]"></div>
      <Header />
      <div class="relative flex-1">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>
