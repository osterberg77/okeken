---
import Calendar from '../components/Calendar';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicEvents } from '../lib/events';
import { dayKey } from '../lib/time';

const events = await getPublicEvents();
const siteUrl = Astro.site!.origin;
---

<BaseLayout title="OK Eken – orientering i Åtvidaberg" ogTitle="OK Eken">
  <main class="mx-auto max-w-6xl px-4 py-6 sm:py-8">
    <Calendar client:load events={events} initialToday={dayKey(new Date())} siteUrl={siteUrl} />
  </main>
</BaseLayout>
