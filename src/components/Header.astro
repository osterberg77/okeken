---
import AccountMenu from './AccountMenu';

// Mått enligt docs/skisser/kalender-och-kontrollsymboler.md (desktop); nedskalat på mobil.
const path = Astro.url.pathname;

// Om oss och Bli medlem pekar tills vidare på gamla sajten, tills sidorna finns här.
const links = [
  { href: '/', label: 'Kalender', active: path === '/' || path.startsWith('/event') },
  { href: 'https://www.okeken.se/om-ok-eken', label: 'Om oss', active: false },
  { href: 'https://www.okeken.se/bli-medlem', label: 'Bli medlem', active: false },
];
---

<header class="relative z-[5]">
  <div class="mx-auto flex max-w-[1240px] flex-wrap items-start gap-3 px-4 pt-4 pb-2 sm:gap-5 sm:px-8 sm:pt-[22px]">
    <a href="/" aria-label="OK Eken Åtvidaberg – startsida" class="block">
      <img
        src="/logo.svg"
        alt="OK Eken Åtvidaberg"
        width="138"
        height="153"
        class="block h-auto w-[64px] drop-shadow-[0_14px_18px_rgba(43,40,56,.18)] sm:w-[138px]"
      />
    </a>
    <nav aria-label="Huvudmeny" class="order-last -mt-1 flex w-full flex-wrap gap-0 sm:order-none sm:mt-[23px] sm:ml-6 sm:w-auto sm:flex-1 sm:gap-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={l.active ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap rounded-full px-2.5 py-1.5 text-[15px] leading-[1.2] no-underline sm:px-6 sm:py-2.5 sm:text-[30px]',
              l.active ? 'bg-white font-semibold text-ink shadow-[0_1px_3px_rgba(43,40,56,.08)]' : 'font-medium text-muted hover:text-ink',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-2 ml-auto flex items-center gap-1 sm:mt-[21px] sm:gap-2">
      <a
        href="/sok"
        aria-label="Sök"
        aria-current={path === '/sok' ? 'page' : undefined}
        class="grid h-9 w-9 place-items-center rounded-full text-muted no-underline hover:text-ink sm:h-11 sm:w-11"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5 sm:h-6 sm:w-6">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
      <AccountMenu client:load />
    </div>
  </div>
</header>
