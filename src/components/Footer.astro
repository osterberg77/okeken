---
import { CLUB } from '../lib/club';
---

<footer class="relative bg-ink text-[#E9E6F0]">
  <div class="mx-auto flex max-w-[1240px] flex-wrap items-start gap-x-16 gap-y-7 p-8 text-sm">
    <div class="flex items-center gap-3">
      <img src="/logo.svg" alt="" width="42" height="47" class="block h-auto w-[42px]" loading="lazy" />
      <span class="font-display text-xl font-bold">{CLUB.name}</span>
    </div>
    <div class="flex flex-col gap-[3px]">
      <span class="text-xs font-semibold tracking-[.14em] text-[#A9A3BD]">KONTAKT</span>
      <a href={`mailto:${CLUB.email}`} class="hover:underline">{CLUB.email}</a>
      <a href={`tel:${CLUB.phone.replace(/\s/g, '')}`} class="hover:underline">{CLUB.phone}</a>
      <span>{CLUB.address}</span>
    </div>
    <div class="flex flex-col gap-[3px]">
      <span class="text-xs font-semibold tracking-[.14em] text-[#A9A3BD]">LÄNKAR</span>
      <span class="flex flex-wrap gap-x-1.5">
        <a href={CLUB.facebook} class="hover:underline" target="_blank" rel="noopener">Facebook</a><span aria-hidden="true">·</span>
        <a href={CLUB.eventor} class="hover:underline" target="_blank" rel="noopener">Eventor</a><span aria-hidden="true">·</span>
        <a href={CLUB.livelox} class="hover:underline" target="_blank" rel="noopener">Livelox</a>
      </span>
      <a href="/integritet" class="hover:underline">Integritetspolicy</a>
      <span>Bildad {CLUB.founded}</span>
    </div>
  </div>
</footer>
