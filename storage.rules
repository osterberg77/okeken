rules_version = '2';

// PDF-banor: courses/<eventId>/<slumpat>-<namn>.pdf. Alla med länken får hämta filen men ingen får lista
// (länkarna har slumpat prefix och står inte på sidan förrän eventet publicerats). Bara publicerare,
// styrelse, superadmin och banläggare får ladda upp, och bara nya filer: ingen skriver över eller raderar
// (publicerade ögonblicksbilder pekar på filerna). Behörigheten läses från users/{uid} i Firestore.
// Bildbanken (image_bank/, beslut 0007) beskrivs vid sin regel nedan. Allt annat nekas.
// Regeltester: tests/rules/storage.test.ts
service firebase.storage {
  match /b/{bucket}/o {

    function canUploadCourses() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.permissions
          .hasAny(['course_setter', 'publisher', 'board', 'superadmin']);
    }

    match /courses/{eventId}/{fileName} {
      // get men inte list: den som saknar länken ska inte kunna räkna upp filerna (banor kan vara hemliga före tävling)
      allow get: if true;
      allow list: if false;

      // Bara nya filer: i produktion gäller 'create' inte befintliga objekt (överskrivning är 'update', som nekas nedan).
      // OBS: referera inte till `resource` här (`resource == null` gav "Null value error" i Rules-tjänsten och nekade
      // uppladdning av nya filer) och `request.method` finns inte i Storage-regler. Emulatorn räknar en överskrivning
      // som create, så överskrivningsskyddet kan inte testas där.
      // TILLFÄLLIGT SLAPPA REGLER (Erik 2026-10-21): uppladdning nekades med 403 i produktion och orsaken är okänd.
      // Bara inloggad + PDF + högst 10 MB tills vidare. TAJTA TILL FÖRE RELEASE (se docs/plan.md): kräv canUploadCourses()
      // (rollkontroll via Firestore), filnamnsmönster, ingen contentDisposition/contentEncoding/egen metadata.
      // Den strikta varianten finns i git-historiken (commit e247536) och i tests/rules/storage.test.ts (avstängda tester).
      allow create: if request.auth != null
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024;

      allow update: if false;

      // Radering när en bana tagits bort från ett event (editorn raderar filer som varken utkast eller publicerad
      // version pekar på). TILLFÄLLIGT SLAPP som uppladdningen: vilken inloggad användare som helst. Tajta till före
      // release (kräv canUploadCourses()), se docs/plan.md.
      allow delete: if request.auth != null;
    }

    // ---- Bildbank (beslut 0007) ----------------------------------------------------------
    // Platt mapp: image_bank/<imageId>-<original|web|thumbnail>.<jpg|png|webp>, där imageId är id för
    // posten i Firestore (imageBank/{imageId}). Alla med länken får hämta (bilderna visas för besökare via
    // nedladdnings-URL med token), ingen får lista. Bara publicerare, styrelse och superadmin får ladda upp
    // och radera. Uppladdning bara av nya filer och bara innan posten skapats; radering bara när posten är
    // borta, så att filer som en post (och publicerade sidor) pekar på inte kan tas bort eller ersättas.
    // Högst två Firestore-dokument läses per anrop (users/{uid} och imageBank/{imageId}).

    function canPublishImages() {
      // get på saknat dokument ger null och därmed fel, vilket nekar
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.permissions
          .hasAny(['publisher', 'board', 'superadmin']);
    }

    function validImageFileName(fileName) {
      return fileName.matches('^[A-Za-z0-9]{1,64}-(original|web|thumbnail)[.](jpg|png|webp)$');
    }

    // Kräver giltigt filnamn först (id:t sätts in i Firestore-sökvägen)
    function imagePostExists(fileName) {
      return firestore.exists(/databases/(default)/documents/imageBank/$(fileName.split('-')[0]));
    }

    match /image_bank/{fileName} {
      allow get: if true;
      allow list: if false;

      // Bara nya filer, se kommentaren vid courses/ ovan (ingen referens till `resource`)
      // TILLFÄLLIGT SLAPPA REGLER (Erik 2026-10-21), se kommentaren vid courses/. Bara inloggad + jpeg/png/webp + högst 10 MB.
      // TAJTA TILL FÖRE RELEASE: canPublishImages(), validImageFileName, ändelse = typ, !imagePostExists, ingen extra
      // metadata (strikt variant: commit e247536).
      allow create: if request.auth != null
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024;

      allow delete: if validImageFileName(fileName)
        && canPublishImages()
        && !imagePostExists(fileName);

      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
